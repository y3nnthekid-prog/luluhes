# Salin ke .env.local untuk pengembangan lokal.
# Di produksi, isi lewat Vercel → Settings → Environment Variables.
# JANGAN pernah commit file .env.local — sudah diabaikan lewat .gitignore.

# Kunci API Anthropic. Kalau kosong, asisten tetap jalan: ia menjawab
# langsung dari data tanpa perapian model, dan tanpa biaya sama sekali.
ANTHROPIC_API_KEY=

# Model yang dipakai. Kosongkan untuk memakai claude-haiku-4-5 (paling murah).
# Alternatif: claude-sonnet-5 (jawaban lebih luwes, sekitar 3x biaya input).
ASISTEN_MODEL=

# Batas panggilan model per hari per instance. Kosongkan untuk memakai 150.
ASISTEN_LIMIT_HARIAN=

# ── Papan skor global mini game ────────────────────────────────────────
# Kalau dua ini kosong, papan skor tetap jalan tetapi hanya menampilkan skor
# di peramban masing-masing, dan panelnya jujur menulis "Perangkat ini saja".
#
# Cara mengisinya: Vercel -> Storage -> Upstash Redis -> Create. Vercel
# memasang KV_REST_API_URL dan KV_REST_API_TOKEN sendiri ke project ini.
KV_REST_API_URL=
KV_REST_API_TOKEN=
